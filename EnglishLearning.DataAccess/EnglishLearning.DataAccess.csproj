<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>viwik.$(AssemblyName)</PackageId>
    <Version>1.0.0</Version>
    <Authors>vi-wik</Authors>
    <Description>英语学习数据访问层</Description>
    <RepositoryType></RepositoryType>
    <PackageReleaseNotes>初始发行</PackageReleaseNotes>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <RepositoryUrl>https://github.com/vi-wik/EnglishLearning</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnglishLearning.Data\EnglishLearning.Data.csproj" />
    <ProjectReference Include="..\EnglishLearning.Model\EnglishLearning.Model.csproj" />
    <ProjectReference Include="..\EnglishLearning.Utility\EnglishLearning.Utility.csproj" />
  </ItemGroup>

</Project>
